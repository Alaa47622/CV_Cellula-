   "source": [
    "# 04 — Model Comparison & Deployment Discussion\n",
    "\n",
    "Loads the saved metrics/reports from `02_scratch_cnn.ipynb` and `03_transfer_learning.ipynb` and compares them:\n",
    "overall accuracy, per-class F1 (imbalance effect), model size, and inference speed — to answer the brief's\n",
    "final question: *which model is better for real-time deployment?*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e72cd114",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "BACKBONE = \"resnet50\"  # must match what you used in 03_transfer_learning.ipynb\n",
    "\n",
    "with open(\"artifacts/scratch_cnn_metrics.json\") as f:\n",
    "    scratch_metrics = json.load(f)\n",
    "with open(f\"artifacts/{BACKBONE}_metrics.json\") as f:\n",
    "    pretrained_metrics = json.load(f)\n",
    "\n",
    "scratch_report = pd.read_csv(\"artifacts/scratch_cnn_classification_report.csv\", index_col=0)\n",
    "pretrained_report = pd.read_csv(f\"artifacts/{BACKBONE}_classification_report.csv\", index_col=0)\n",
    "\n",
    "CLASSES = [\"Normal\", \"Diabetic Retinopathy\", \"Others\", \"Glaucoma\",\n",
    "           \"Cataract\", \"Myopia\", \"AMD\", \"Hypertension\"]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "201267c7",
   "metadata": {},
   "source": [
    "## Headline comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fde42484",
   "metadata": {},
   "outputs": [],
   "source": [
    "comparison = pd.DataFrame([scratch_metrics, pretrained_metrics]).set_index(\"model\")\n",
    "comparison[\"throughput_fps\"] = 1000 / comparison[\"ms_per_image\"]\n",
    "comparison[[\"test_accuracy\", \"macro_f1\", \"weighted_f1\", \"ms_per_image\", \"throughput_fps\", \"n_params\"]]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "70297547",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "\n",
    "comparison[[\"test_accuracy\", \"macro_f1\"]].plot(kind=\"bar\", ax=axes[0])\n",
    "axes[0].set_title(\"Accuracy / Macro-F1\"); axes[0].set_ylim(0, 1); axes[0].tick_params(axis='x', rotation=20)\n",
    "\n",
    "comparison[\"ms_per_image\"].plot(kind=\"bar\", ax=axes[1], color=\"orange\")\n",
    "axes[1].set_title(\"Latency (ms/image, lower=better)\"); axes[1].tick_params(axis='x', rotation=20)\n",
    "\n",
    "comparison[\"n_params\"].plot(kind=\"bar\", ax=axes[2], color=\"green\")\n",
    "axes[2].set_title(\"Parameter count\"); axes[2].tick_params(axis='x', rotation=20)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"artifacts/model_comparison_overview.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "616496c9",
   "metadata": {},
   "source": [
    "## Per-class F1 — effect of class imbalance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "987093b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "per_class = pd.DataFrame({\n",
    "    \"scratch_cnn_f1\": scratch_report.loc[CLASSES, \"f1-score\"],\n",
    "    \"pretrained_f1\": pretrained_report.loc[CLASSES, \"f1-score\"],\n",
    "    \"support\": scratch_report.loc[CLASSES, \"support\"],\n",
    "}).sort_values(\"support\", ascending=False)\n",
    "per_class"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "58c0fe23",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "per_class[[\"scratch_cnn_f1\", \"pretrained_f1\"]].plot(kind=\"bar\", ax=ax)\n",
    "ax.set_title(\"Per-class F1: Scratch CNN vs Fine-tuned Pretrained Model\\n(sorted by training support, left=most data)\")\n",
    "ax.set_ylabel(\"F1-score\"); ax.set_xticklabels(per_class.index, rotation=35, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"artifacts/per_class_f1_comparison.png\", dpi=150)\n",
    "plt.show()"
   ]
  },
